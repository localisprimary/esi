{
  "name": "@localisprimary/esi",
  "version": "2.0.17",
  "type": "module",
  "description": "Auto-generated TypeScript client for the EVE Online API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.ts && pnpm lint:fix && pnpm format",
    "build": "tsc -p scripts/tsconfig.json && rimraf dist && tsc && tsc -p tsconfig.test.json",
    "compile": "pnpm generate && pnpm build && pnpm test",
    "lint": "oxlint src scripts vitest.config.ts",
    "lint:fix": "oxlint src scripts vitest.config.ts --fix",
    "format": "oxfmt",
    "test": "vitest run",
    "change": "beachball change"
  },
  "keywords": [
    "eve",
    "eveonline",
    "eve online",
    "esi",
    "api",
    "client",
    "typescript"
  ],
  "author": "Adam Trager <hello@adamtrager.com>",
  "funding": "https://buymeacoffee.com/nfinished",
  "repository": {
    "type": "git",
    "url": "https://github.com/localisprimary/esi.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/ui": "^4.1.10",
    "beachball": "^2.65.5",
    "camelcase": "^9.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^24.13.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
